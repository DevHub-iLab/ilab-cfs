---
/**
 * The lab's mark, painted from `public/favicon.svg` — the same drawing the
 * browser tab shows, so there is one file to change when it changes.
 *
 * It is a mask rather than an `<img>` because the file draws itself in
 * `currentColor`: inside an `<img>` that resolves against the image's own
 * context, where it falls back to black and disappears on this ground. Masking
 * paints a colour we choose through the file's shape instead.
 *
 * The file is square (24x24), so one `size` sets both edges.
 */
interface Props {
	/** Edge length in px. */
	size?: number;
	/**
	 * An accessible name. Omit inside something already labelled — a link with
	 * its own `aria-label` — so it is not announced twice.
	 */
	label?: string;
	class?: string;
}

const { size = 20, label, class: className } = Astro.props;
---

<span
	class:list={['wordmark', className]}
	style={`width: ${size}px; height: ${size}px;`}
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
></span>

<style>
	/* Prefixed first, standard last: the minifier treats the pair as one
	   property and keeps whichever it sees last. */
	.wordmark {
		display: block;
		flex: none;
		background: var(--color-accent);
		-webkit-mask-image: url('/favicon.svg');
		mask-image: url('/favicon.svg');
		-webkit-mask-size: contain;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-position: center;
		mask-position: center;
	}
</style>
