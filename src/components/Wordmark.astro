---
/**
 * The lab's logotype, painted from `public/ilab.svg`.
 *
 * It is a mask rather than an `<img>` because the file draws itself in
 * `currentColor`: inside an `<img>` that resolves against the image's own
 * context, where it falls back to black and disappears on this ground. Masking
 * paints a colour we choose through the file's shape, so the mark stays the
 * accent everywhere and the file stays the single source of the artwork.
 *
 * The file is 345x130, so `size` is its HEIGHT and the width follows from the
 * ratio — it is a logotype, not a square icon. (`favicon.svg` is the browser
 * tab's 24x24 mark and a different drawing entirely.)
 */
interface Props {
	/** Height in px. */
	size?: number;
	/**
	 * An accessible name. Omit inside something already labelled — a link with
	 * its own `aria-label` — so it is not announced twice.
	 */
	label?: string;
	class?: string;
}

const { size = 20, label, class: className } = Astro.props;

const RATIO = 345 / 130;
const width = Math.round(size * RATIO);
---

<span
	class:list={['wordmark', className]}
	style={`width: ${width}px; height: ${size}px;`}
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
></span>

<style>
	/* Prefixed first, standard last: the minifier treats the pair as one
	   property and keeps whichever it sees last. */
	.wordmark {
		display: block;
		flex: none;
		background: var(--color-accent);
		-webkit-mask-image: url('/ilab.svg');
		mask-image: url('/ilab.svg');
		-webkit-mask-size: contain;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-position: left center;
		mask-position: left center;
	}
</style>
