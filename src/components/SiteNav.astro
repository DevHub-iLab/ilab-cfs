---
import Wordmark from './Wordmark.astro';
import type { User } from '../lib/auth';

interface Props {
	/** From `Astro.locals.user`. Decides the links and the right-hand actions. */
	user: User | null;
	current?: 'proposals' | 'schedule' | 'archive';
	/**
	 * Where this page's own content column starts, as a CSS length. The links
	 * line up with it, so the masthead reads as part of the page rather than a
	 * bar floating above it. Defaults to the `page-x` column most pages use; a
	 * page laying itself out differently passes its own.
	 */
	align?: string;
}

const {
	user,
	current,
	align = 'max(var(--page-edge), calc((100% - 1060px) / 2 + var(--page-edge)))',
} = Astro.props;

const links = [
	{ href: '/schedule', label: 'Schedule', key: 'schedule' as const, icon: '/calendar.svg' },
	{ href: '/archive', label: 'Archive', key: 'archive' as const, icon: '/archive.svg' },
];

const initial = (user?.name || user?.email || '?').trim().charAt(0).toUpperCase();
---

{/*
  One masthead for every page.

  The artboards vary it per screen — the editor's is stripped to a status and
  two buttons, the speaker's list swaps the actions for an avatar — but varying
  the chrome itself made moving between pages feel like moving between sites.
  What stays is the frame: same height, same edges, same links, same behaviour.
  What varies is only what must — which link is current, whether you are signed
  in, and one slot of page context.

  At rest it carries neither ground nor rule, so a page opens on an unbroken
  hero; it frosts once the page moves underneath it.
*/}
<header class="nav gap-[18px] py-[8px]" data-nav>
	<a
		class="nav-brand nav-mark no-underline"
		href="/"
		aria-label="iLab CFS — home"
		style={`--align: ${align}; --mark: 20px;`}
	>
		<Wordmark size={20} />
	</a>

	{/* Page context — the editor's save state, say. Empty on most pages. */}
	<slot name="status" />

	{
		links.map((link) => (
			<a
				class="nav-link hidden sm:inline-flex"
				href={link.href}
				aria-current={current === link.key ? 'page' : undefined}
			>
				<span class="nav-icon" style={`--icon: url('${link.icon}');`} aria-hidden="true" />
				{link.label}
			</a>
		))
	}

	<div class="ml-auto flex items-center gap-[9px] pr-[16px]">
		{
			!user && (
				<a class="btn btn-ghost" style="padding: 7px 12px;" href="/sign-in">
					Sign in
				</a>
			)
		}

		{/*
		  The call to action is for everyone. Signing in is not the point of the
		  place — pitching is — and a speaker who has just signed in is the one
		  most likely to want it.
		*/}
		<a class="btn btn-primary" style="padding: 7px 14px;" href="/proposals/new">
			Submit a proposal
		</a>

		{
			user && (
				<div class="relative" data-user-menu>
					<button
						type="button"
						class="flex h-[24px] w-[24px] flex-none cursor-pointer items-center justify-center rounded-full border-0 text-[11px]"
						style="background: var(--color-accent-800); box-shadow: inset 0 0 0 1px var(--color-accent-700); color: var(--color-accent-100);"
						aria-label="Account menu"
						aria-haspopup="menu"
						aria-expanded="false"
						aria-controls="user-menu"
						title={user.email}
						data-user-menu-button
					>
						<span aria-hidden="true">{initial}</span>
					</button>

					<div id="user-menu" class="user-menu" role="menu" aria-label="Account">
						<span class="user-menu-who" role="presentation">{user.email}</span>
						<a
							class="user-menu-item"
							role="menuitem"
							href="/proposals"
							aria-current={current === 'proposals' ? 'page' : undefined}
						>
							My proposals
						</a>
						<form method="post" action="/sign-out">
							<button class="user-menu-item" role="menuitem" type="submit">
								Sign out
							</button>
						</form>
					</div>
				</div>
			)
		}
	</div>

	{
		user && (
			<noscript>
				<a href="/proposals">My proposals</a>
				<form method="post" action="/sign-out" style="display: inline;">
					<button class="btn btn-ghost" style="padding: 7px 12px;" type="submit">
						Sign out
					</button>
				</form>
			</noscript>
		)
	}
</header>

<style>
	/*
	  Unlayered on purpose: `.nav` lives in `@layer components`, and an
	  unlayered rule beats every layered one outright, so none of this has to
	  win a specificity argument with the component it is dressing.
	*/
	header {
		position: sticky;
		top: 0;
		z-index: 50;
	}

	/*
	  The frost is a pseudo-element that fades in, rather than properties on the
	  masthead that animate from their resting values. At rest it is not painted
	  at all, so the masthead is genuinely nothing — no ground, no rule, and no
	  identity `backdrop-filter` sitting there tinting the page through a
	  compositing pass. It is also what keeps the rule from occupying a pixel of
	  layout before it is visible: the box is taken out of flow.
	*/
	header::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;

		opacity: 0;
		transition: opacity 220ms ease;

		/* The opaque ground is the default, not the fallback: a two-thirds
		   transparent bar over scrolling text is unreadable, so legibility must
		   not depend on a filter landing. The frost is layered over it below,
		   where it can be painted. */
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-divider);
	}

	/*
	  Prefixed first, standard last, and not the other way round: the CSS
	  minifier treats the pair as one property and keeps the last one it sees,
	  so authoring them in reverse silently ships WebKit's prefix alone and
	  leaves Firefox translucent with nothing blurred behind it.
	*/
	@supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
		header::before {
			background: color-mix(in srgb, var(--color-bg) 68%, transparent);
			-webkit-backdrop-filter: blur(16px) saturate(180%);
			backdrop-filter: blur(16px) saturate(180%);
		}
	}

	header[data-stuck]::before {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		header::before {
			transition: none;
		}
	}

	/*
	  The brand sits hard against the window's left edge, and reserves exactly
	  enough width that the first link begins on the page's own content column
	  — level with the title below it.
	
	  A width rather than absolute positioning: taken out of flow the mark
	  would overlap the links at any width where the column starts before the
	  mark ends, which is every screen narrower than the column. The `max()`
	  floors it at the mark's own size, so a narrow screen stops aligning
	  rather than colliding.
	
	  The header carries no horizontal padding of its own, which is what lets
	  `100%` inside `--align` mean the window rather than the window less that
	  padding. The right edge is padded on the actions group instead.
	*/
	.nav-mark {
		display: flex;
		align-items: center;
		flex: none;
		margin-right: 0;
		padding-left: 16px;
		width: max(calc(16px + var(--mark)), calc(var(--align) - 18px));
	}

	/*
	  The links are near-white and dimmed, coming to full strength on hover and
	  on the page you are on. `--color-text` rather than `#fff`: it is the
	  system's own white (#e9e9ed), so the masthead matches every other surface
	  instead of being a slightly brighter white beside them.

	  These are scoped to `.nav-link` rather than `.nav a`, which would also
	  catch the brand. Being unlayered they beat `.nav a:hover`'s accent colour
	  from the component layer without a specificity contest.
	*/
	.nav-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 12.5px;
		color: color-mix(in srgb, var(--color-text) 65%, transparent);
		transition: color 140ms ease;
	}

	.nav-link:hover,
	.nav-link:focus-visible,
	.nav-link[aria-current='page'] {
		color: var(--color-text);
	}

	/*
	  The icons are masks, not images. Both files paint with `currentColor`,
	  which an <img> cannot resolve — it renders in its own context, where the
	  colour would fall back to black and vanish on this ground. Masking paints
	  `currentColor` through the file's shape instead, so an icon dims and
	  brightens with the label beside it, including through the transition.

	  Prefixed first, standard last: the minifier treats the pair as one property
	  and keeps whichever it sees last.
	*/
	.nav-icon {
		width: 14px;
		height: 14px;
		flex: none;
		background: currentColor;
		-webkit-mask-image: var(--icon);
		mask-image: var(--icon);
		-webkit-mask-size: contain;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-position: center;
		mask-position: center;
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-link {
			transition: none;
		}
	}

	/*
	  The menu is always laid out and never display:none — it is hidden with
	  `visibility` instead. That is what makes the animation dependable: a box
	  whose `display` flips cannot transition without `@starting-style` and
	  `transition-behavior: allow-discrete`, which are recent enough to be worth
	  not depending on. `visibility` animates discretely by definition, flipping
	  at the start of the opening transition and the end of the closing one, so
	  the fade is visible in both directions — and while hidden it is out of the
	  accessibility tree and takes no clicks.
	*/
	.user-menu {
		position: absolute;
		top: calc(100% + 10px);
		right: 0;
		z-index: 1;

		display: flex;
		flex-direction: column;
		min-width: 190px;
		padding: var(--space-2);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		box-shadow: var(--shadow-md);

		opacity: 0;
		visibility: hidden;
		translate: 0 -6px;
		scale: 0.97;
		transform-origin: top right;
		transition:
			opacity 150ms ease,
			translate 150ms ease,
			scale 150ms ease,
			visibility 150ms;
	}

	[data-user-menu][data-open] .user-menu {
		opacity: 1;
		visibility: visible;
		translate: 0 0;
		scale: 1;
	}

	.user-menu-who {
		padding: 6px 10px 8px;
		font-size: 11.5px;
		color: color-mix(in srgb, var(--color-text) 50%, transparent);
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.user-menu form {
		display: contents;
	}

	.user-menu-item {
		display: block;
		width: 100%;
		padding: 7px 10px;
		border: 0;
		border-radius: var(--radius-sm);
		background: transparent;
		font: inherit;
		font-size: 13.5px;
		color: var(--color-text);
		text-align: left;
		text-decoration: none;
		cursor: pointer;
	}

	.user-menu-item:hover,
	.user-menu-item:focus-visible {
		background: color-mix(in srgb, var(--color-text) 8%, transparent);
		color: var(--color-accent);
	}

	.user-menu-item[aria-current='page'] {
		color: var(--color-accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.user-menu {
			transition: visibility 150ms;
		}
	}
</style>

<script>
	const header = document.querySelector<HTMLElement>('[data-nav]');

	if (header) {
		let stuck = false;

		/*
		  8px rather than 0: scroll restoration and a trackpad's rubber-banding
		  both settle a pixel or two off zero, and a rule that flickers at rest
		  is worse than one that arrives a moment late.

		  The guard matters more than the threshold — `scroll` fires far more
		  often than the state changes, and writing the attribute on every frame
		  would invalidate style for no reason.
		*/
		const update = () => {
			const next = window.scrollY > 8;
			if (next === stuck) return;
			stuck = next;
			header.toggleAttribute('data-stuck', next);
		};

		// Run once: a reload can restore a scroll position well down the page.
		update();
		addEventListener('scroll', update, { passive: true });
	}

	// ── account menu ──────────────────────────────────────────────────────
	const menuRoot = document.querySelector<HTMLElement>('[data-user-menu]');
	const menuButton = document.querySelector<HTMLButtonElement>('[data-user-menu-button]');
	const menu = document.querySelector<HTMLElement>('#user-menu');

	if (menuRoot && menuButton && menu) {
		const items = () => [...menu.querySelectorAll<HTMLElement>('.user-menu-item')];

		function setOpen(open: boolean, focusFirst = false) {
			menuRoot!.toggleAttribute('data-open', open);
			menuButton!.setAttribute('aria-expanded', String(open));
			if (open && focusFirst) items()[0]?.focus();
		}

		const isOpen = () => menuRoot.hasAttribute('data-open');

		menuButton.addEventListener('click', () => setOpen(!isOpen(), true));

		// Anywhere outside closes it — including the rest of the masthead.
		document.addEventListener('pointerdown', (event) => {
			if (isOpen() && !menuRoot.contains(event.target as Node)) setOpen(false);
		});

        // Escape returns focus to the button, or a keyboard user is left
        // standing on a menu that is no longer there.
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape' || !isOpen()) return;
			setOpen(false);
			menuButton.focus();
		});

		menu.addEventListener('keydown', (event) => {
			if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
			event.preventDefault();
			const list = items();
			const here = list.indexOf(document.activeElement as HTMLElement);
			const next = event.key === 'ArrowDown' ? here + 1 : here - 1;
			list[(next + list.length) % list.length]?.focus();
		});

		// Tabbing past the last item is a deliberate exit, not a dismissal to
		// fight — but the menu should not stay open behind you.
		menu.addEventListener('focusout', (event) => {
			if (!menuRoot.contains(event.relatedTarget as Node)) setOpen(false);
		});
	}
</script>
