---
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout title="iLab Call for Speakers">
	<main class="mx-auto flex min-h-full max-w-2xl flex-col justify-center gap-3 px-8 py-32">
		<h1>Innovation Lab — Call for Speakers</h1>
		<p>
			Pitch a talk for TechTalks, a DevHub workshop, or a Catalyst sharing session.
		</p>
		<!-- component class + utility: the utility wins on margin, .btn keeps the rest -->
		<a class="btn btn-primary mt-2 self-start" href="#">Submit a proposal</a>
		<hr class="hr" />
		<p class="text-muted mb-0">Placeholder page — awaiting design.</p>
	</main>
</Layout>
