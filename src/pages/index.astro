<Layout title="iLab Call for Speakers">
	<main class="mx-auto flex min-h-full max-w-2xl flex-col justify-center gap-4 px-6 py-24">
		<h1 class="text-3xl font-semibold tracking-tight">Innovation Lab — Call for Speakers</h1>
