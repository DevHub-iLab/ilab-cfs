{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-11",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "ilab-cfs",
	"main": "@astrojs/cloudflare/entrypoints/server",
	// Served from the lab's own domain rather than workers.dev. Magic links go
	// out from no-reply@ilabccds.com, and a sign-in link pointing at an
	// unrelated host reads as phishing to recipients and spam filters alike —
	// which matters for a CFP aimed at people outside the lab. The zone is
	// already on Cloudflare, so wrangler creates the DNS record itself.
	"routes": [{ "pattern": "cfs.ilabccds.com", "custom_domain": true }],
	"vars": {
		// Public, so it lives here rather than in a secret: it is the origin
		// Better Auth builds links and scopes cookies against, and keeping it
		// beside the route above is what stops the two drifting apart.
		// Scheme included, no trailing slash. `.dev.vars` overrides it locally.
		"BETTER_AUTH_URL": "https://cfs.ilabccds.com"
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// D1 is the system of record. `migrations_dir` points at drizzle-kit's
	// output so `wrangler d1 migrations apply` is the only apply path.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ilab-cfs",
			"database_id": "c73766ca-354e-4af9-b92e-62d20a8f60c7",
			"migrations_dir": "./migrations"
		}
	],
	// Better Auth's session cache. Deliberately NOT named `SESSION`: the
	// Astro adapter auto-wires its own Sessions API to a binding of that
	// name, which would quietly compete with Better Auth for identity.
	// Nothing here is authoritative — every value is reconstructible from D1.
	"kv_namespaces": [
		{
			"binding": "AUTH_KV",
			"id": "d47baf20f3dd4ef6bef945b6c3dd685f"
		}
	]
}
